<!-- Modal طلب الخدمة -->
<div id="requestModal" class="modal">
    <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h3 id="modalTitle" style="margin-bottom: 20px;">طلب خدمة</h3>
        <input type="text" id="fullName" placeholder="الاسم الكامل" required>
        <input type="tel" id="phoneNumber" placeholder="رقم الهاتف" required>
        <textarea id="problemDesc" rows="3" placeholder="وصف المشكلة بالتفصيل"></textarea>
        <div style="display: flex; gap: 8px;">
            <input type="text" id="locationInput" placeholder="موقعك (GPS أو عنوان)" style="flex:1">
            <button id="getLocationBtn" style="background:#e2e8f0; border:none; border-radius:16px; padding:0 16px;"><i class="fas fa-location-dot"></i></button>
        </div>
        <select id="serviceTypeSelect" style="margin-top:12px;">
            <option value="mechanic">ميكانيكي متنقل</option>
            <option value="fuel">توصيل وقود</option>
            <option value="depannage">ديبناج (رفع)</option>
            <option value="spare">قطع غيار / زيوت</option>
        </select>
        <button id="submitRequestModal" style="background:#1e3a8a; color:white; width:100%; padding:12px; border-radius:50px; margin-top:20px; font-weight:bold; border:none;">إرسال الطلب</button>
        <p style="font-size:12px; color:#64748b; text-align:center; margin-top:12px;">سيتم التواصل معك خلال 5 دقائق</p>
    </div>
</div>

<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init({ duration: 800, once: true });

    // Modal elements
    const modal = document.getElementById('requestModal');
    const closeModal = document.querySelector('.close-modal');
    const requestBtns = document.querySelectorAll('#requestHelpBtn, #ctaBtn, .service-btn');
    const modalTitle = document.getElementById('modalTitle');
    const serviceSelect = document.getElementById('serviceTypeSelect');
    let currentService = 'mechanic';

    function openModal(service = 'mechanic') {
        modal.style.display = 'flex';
        currentService = service;
        let titleText = '';
        switch(service) {
            case 'mechanic': titleText = 'طلب ميكانيكي متنقل'; break;
            case 'fuel': titleText = 'طلب توصيل وقود'; break;
            case 'depannage': titleText = 'طلب ديبناج (شاحنة رفع)'; break;
            case 'spare': titleText = 'طلب قطع غيار / زيوت'; break;
            default: titleText = 'طلب خدمة';
        }
        modalTitle.innerText = titleText;
        if(serviceSelect) serviceSelect.value = service;
    }

    requestBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
            const service = btn.getAttribute('data-service');
            if(service) openModal(service);
            else openModal('mechanic');
        });
    });

    closeModal.onclick = () => modal.style.display = 'none';
    window.onclick = (e) => { if(e.target === modal) modal.style.display = 'none'; };

    // Fake location
    document.getElementById('getLocationBtn')?.addEventListener('click', () => {
        if(navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                pos => document.getElementById('locationInput').value = `${pos.coords.latitude}, ${pos.coords.longitude}`,
                () => alert('تعذر تحديد الموقع، الرجاء إدخاله يدوياً')
            );
        } else alert('المتصفح لا يدعم خاصية الموقع');
    });

    // Submit Request with toast & store in localStorage
    const submitBtn = document.getElementById('submitRequestModal');
    submitBtn?.addEventListener('click', () => {
        const name = document.getElementById('fullName').value.trim();
        const phone = document.getElementById('phoneNumber').value.trim();
        const problem = document.getElementById('problemDesc').value.trim();
        const location = document.getElementById('locationInput').value.trim();
        const service = serviceSelect ? serviceSelect.value : currentService;

        if(!name || !phone || !location) {
            alert('يرجى ملء الاسم، رقم الهاتف والموقع');
            return;
        }

        // Save to localStorage
        const requests = JSON.parse(localStorage.getItem('website_requests') || '[]');
        const newReq = {
            id: Date.now(),
            name, phone, problem, location, service,
            status: 'قيد الانتظار',
            date: new Date().toLocaleString('ar')
        };
        requests.push(newReq);
        localStorage.setItem('website_requests', JSON.stringify(requests));

        alert(`✅ تم استلام طلبك بنجاح!\nالخدمة: ${service}\nسيتم الاتصال بك قريباً على ${phone}`);
        modal.style.display = 'none';
        document.getElementById('fullName').value = '';
        document.getElementById('phoneNumber').value = '';
        document.getElementById('problemDesc').value = '';
        document.getElementById('locationInput').value = '';
    });

    // Mobile Menu Toggle
    const menuBtn = document.getElementById('mobileMenuBtn');
    const navLinksDiv = document.getElementById('navLinks');
    menuBtn?.addEventListener('click', () => {
        navLinksDiv.classList.toggle('active');
    });

    // Login simulation
    const loginBtn = document.getElementById('loginBtnNav');
    loginBtn?.addEventListener('click', () => {
        alert('🔐 خاصية تسجيل الدخول قيد التطوير (للتوضيح فقط)\nيمكنك تجربة طلب الخدمة كزائر.');
    });

    // Smooth scroll for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if(target) target.scrollIntoView({ behavior: 'smooth' });
            if(navLinksDiv.classList.contains('active')) navLinksDiv.classList.remove('active');
        });
    });
</script>
